# Configure these in Netlify Site configuration > Environment variables.
# Never commit a populated .env file.
NOODLES_API_KEY=
NOODLES_API_URL=https://api.noodles.fi/api/v1/partner/coin-detail?coin_id=0x6c5a609f6d0288523ce4a6ed87d19ae127f62073ab75fd9b0b1c9b455d4895cf::tree::TREE
COINGECKO_API_KEY=
COINGECKO_API_PLAN=
BLOCKVISION_API_KEY=
SUI_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql
SUI_GRAPHQL_PAGE_SIZE=50
SUI_GRAPHQL_MAX_PAGES=40
SUI_GRAPHQL_MAX_SCAN_MS=8000
TREE_LEADERBOARD_REFRESH_SECRET=
SUI_GRAPHQL_BACKGROUND_PAGE_SIZE=50
SUI_GRAPHQL_BACKGROUND_MAX_PAGES=5000
SUI_GRAPHQL_BACKGROUND_MAX_SCAN_MS=840000
SUI_GRAPHQL_BACKGROUND_PROGRESS_PAGES=25
SUI_GRAPHQL_BACKGROUND_MAX_RETRIES=5
TREE_LEADERBOARD_STALE_AFTER_MS=28800000

# Preview-only total-exposure leaderboard controls.
TREE_EXPOSURE_AUTO_BOOTSTRAP=false
TREE_EXPOSURE_PREVIEW_BRANCH=feature/leaderboard-exposure-v1
TREE_BURN_BADGES_ENABLED=false

# TREE_BURN_BADGES_ENABLED gates the bounded lifetime zero-address transaction scan.
# Trading badges use NOODLES_API_KEY and fail closed if the indexed 30-day pool scan is incomplete.


# Separate behavioral badge index. Badge history never blocks exposure ranking.
TREE_BADGE_AUTO_BOOTSTRAP=false
TREE_BADGE_PREVIEW_BRANCH=feature/leaderboard-badges-v1
TREE_BADGE_REFRESH_SECRET=
TREE_BADGE_PRODUCTION_ENABLED=false
TREE_BADGE_STALE_AFTER_MS=21600000
