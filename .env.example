# Configure these in Netlify Site configuration > Environment variables.
# Never commit a populated .env file.
NOODLES_API_KEY=
NOODLES_API_URL=https://api.noodles.fi/api/v1/partner/coin-detail?coin_id=0x6c5a609f6d0288523ce4a6ed87d19ae127f62073ab75fd9b0b1c9b455d4895cf::tree::TREE
COINGECKO_API_KEY=
COINGECKO_API_PLAN=
BLOCKVISION_API_KEY=
SUI_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql
SUI_GRAPHQL_PAGE_SIZE=50
SUI_GRAPHQL_MAX_PAGES=40
SUI_GRAPHQL_MAX_SCAN_MS=8000
TREE_LEADERBOARD_REFRESH_SECRET=
SUI_GRAPHQL_BACKGROUND_PAGE_SIZE=50
SUI_GRAPHQL_BACKGROUND_MAX_PAGES=5000
SUI_GRAPHQL_BACKGROUND_MAX_SCAN_MS=840000
SUI_GRAPHQL_BACKGROUND_PROGRESS_PAGES=25
SUI_GRAPHQL_BACKGROUND_MAX_RETRIES=5
TREE_LEADERBOARD_STALE_AFTER_MS=28800000

# Complete-only Liquid TREE + verified LP exposure snapshot.
TREE_EXPOSURE_REFRESH_SECRET=
TREE_EXPOSURE_PRODUCTION_ENABLED=false
TREE_EXPOSURE_AUTO_BOOTSTRAP=false
TREE_EXPOSURE_PREVIEW_BRANCH=feature/leaderboard-exposure-v1
TREE_EXPOSURE_STALE_AFTER_MS=28800000
TREE_BURN_BADGES_ENABLED=false

# TREE_BURN_BADGES_ENABLED is retained only for the legacy inline preview scanner and remains false.
# The isolated behavioral badge worker below uses Sui GraphQL for both activity and burn history.

# Separate behavioral badge index. Badge history never blocks exposure ranking.
TREE_BADGE_AUTO_BOOTSTRAP=false
TREE_BADGE_PREVIEW_BRANCH=feature/leaderboard-badges-v1
TREE_BADGE_REFRESH_SECRET=
TREE_BADGE_PRODUCTION_ENABLED=false
TREE_BADGE_STALE_AFTER_MS=28800000
TREE_TOKEN_CREATION_CHECKPOINT=169361209

# Published production schedules are defined in code:
# - Direct fallback leaderboard: minute 17 every 6 hours
# - Verified exposure snapshot: minute 27 every 6 hours
# - Behavioral badge snapshot: minute 47 every 6 hours
## Server-only raffle ledger. Never expose the secret key in browser code.
TREE_RAFFLE_SUPABASE_URL=
TREE_RAFFLE_SUPABASE_SECRET_KEY=
TREE_RAFFLE_INGEST_ENDPOINT=
TREE_RAFFLE_INGEST_ENABLED=false
TREE_RAFFLE_INGEST_SECRET=
TREE_RAFFLE_ACCEPTING_ENTRIES=false
# Optional ISO timestamp shown by the public countdown after the controlled
# rehearsal is complete. Leave blank until the public launch is approved.
TREE_RAFFLE_PUBLIC_LAUNCH_AT=
## TREE Knowledge Trial. All three gates must be true before public scored attempts can open.
TREE_KNOWLEDGE_TRIAL_ENABLED=false
TREE_KNOWLEDGE_TRIAL_LEGAL_APPROVED=false
TREE_KNOWLEDGE_TRIAL_DATABASE_READY=false
TREE_KNOWLEDGE_TRIAL_QUESTION_SET_READY=false
TREE_KNOWLEDGE_TRIAL_SUPABASE_URL=
TREE_KNOWLEDGE_TRIAL_SUPABASE_SECRET_KEY=
TREE_KNOWLEDGE_TRIAL_RATE_LIMIT_SECRET=
# Server-only secret for the non-linked draft setup tool. Use at least 32 random characters.
TREE_KNOWLEDGE_TRIAL_ADMIN_SECRET=
TREE_RAFFLE_CLAIMS_ENABLED=false
TREE_RAFFLE_PRIZES_FUNDED=false
TREE_RAFFLE_DAILY_ENABLED=true
# Staged daily wBTC Lucky Leaf draw. Keep false until the equal free-entry
# route, WBTC prize funding, database support, and dual-prize draw test pass.
TREE_RAFFLE_DAILY_LUCKY_ENABLED=false
TREE_RAFFLE_WEEKLY_ENABLED=false
TREE_RAFFLE_PACKAGE_ID=
TREE_RAFFLE_PRIZE_POOL_ID=
# Server receives only the limited operator capability. Keep AdminCap and
# UpgradeCap in the offline/admin wallet; never place them in Fly or Netlify.
TREE_RAFFLE_OPERATOR_CAP_ID=
TREE_RAFFLE_OPERATOR_ADDRESS=
# Fly-only encrypted secret. Never expose this key to Netlify or browser code.
TREE_RAFFLE_OPERATOR_PRIVATE_KEY=
TREE_RAFFLE_DRAW_EXECUTOR_READY=false
# Fly keeper remains memory-only until these server-only credentials and the migration are installed.
KEEPER_DRY_RUN=true
KEEPER_CURSOR_BACKEND=memory
KEEPER_INGEST_TIMEOUT_MS=12000
KEEPER_DRAW_ENABLED=false
KEEPER_DRAW_DRY_RUN=true
POLL_INTERVAL_MS=5000
