{
  "tables": [
    {
      "acl": "{postgres=arwdDxtm/postgres,service_role=arw/postgres}",
      "rls": true,
      "name": "arcade_bnb_test_challenges",
      "constraints": [
        "CHECK ((chain_id = 56))",
        "CHECK (((address ~ '^0x[0-9a-fA-F]{40}$'::text) AND (lower(address) = wallet)))",
        "CHECK ((isfinite(issued_at) AND isfinite(expires_at) AND (expires_at > issued_at) AND (expires_at <= (issued_at + '00:05:00'::interval))))",
        "CHECK (((consumed_at IS NULL) OR (isfinite(consumed_at) AND (consumed_at >= issued_at) AND (consumed_at < expires_at))))",
        "CHECK ((message_hash ~ '^[a-f0-9]{64}$'::text))",
        "CHECK ((nonce ~ '^[a-f0-9]{64}$'::text))",
        "CHECK ((origin = 'https://tree-token.xyz'::text))",
        "PRIMARY KEY (nonce)",
        "CHECK ((scope = 'eip155:56:treeforce89-test:v1'::text))",
        "CHECK ((uri = 'https://tree-token.xyz/play/multichaintest/game/bnb/'::text))",
        "CHECK (((wallet ~ '^0x[0-9a-f]{40}$'::text) AND (wallet <> ('0x'::text || repeat('0'::text, 40)))))"
      ]
    },
    {
      "acl": "{postgres=arwdDxtm/postgres,service_role=arw/postgres}",
      "rls": true,
      "name": "arcade_bnb_test_sessions",
      "constraints": [
        "CHECK ((chain_id = 56))",
        "FOREIGN KEY (challenge_nonce) REFERENCES private.arcade_bnb_test_challenges(nonce)",
        "UNIQUE (challenge_nonce)",
        "CHECK ((isfinite(issued_at) AND isfinite(expires_at) AND (expires_at > issued_at) AND (expires_at <= (issued_at + '01:00:00'::interval))))",
        "CHECK (((revoked_at IS NULL) OR (isfinite(revoked_at) AND (revoked_at >= issued_at))))",
        "CHECK ((origin = 'https://tree-token.xyz'::text))",
        "PRIMARY KEY (token_sha256)",
        "CHECK ((scope = 'eip155:56:treeforce89-test:v1'::text))",
        "CHECK ((token_sha256 ~ '^[a-f0-9]{64}$'::text))",
        "CHECK ((wallet ~ '^0x[0-9a-f]{40}$'::text))"
      ]
    }
  ],
